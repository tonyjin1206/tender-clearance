{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-clearance.local/schemas/report-input.v1.json",
  "title": "Tender Clearance Report Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "facts", "field_decisions", "quality", "source_artifacts"],
  "properties": {
    "schema_version": {"const": "tender-clearance.report-input.v1"},
    "run": {"type": "object"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "document_id", "field", "value", "method", "location", "evidence_id", "review_state"],
        "properties": {
          "fact_id": {"type": "string"},
          "document_id": {"type": "string"},
          "relative_path": {"type": ["string", "null"]},
          "supplier_dir": {"type": ["string", "null"]},
          "field": {"type": "string"},
          "value": {"type": "string"},
          "normalized": {"type": ["string", "null"]},
          "method": {"type": "string"},
          "location": {"type": "object"},
          "evidence_id": {"type": "string"},
          "review_state": {"enum": ["candidate", "human_review_required"]},
          "review_reason": {"type": "string"}
        }
      }
    },
    "field_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "field", "status", "value", "normalized", "evidence_ids", "candidate_values"],
        "properties": {
          "scope": {"type": "string"},
          "field": {"type": "string"},
          "status": {"enum": ["selected", "missing", "conflict", "needs_manual_review"]},
          "value": {"type": ["string", "null"]},
          "normalized": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "candidate_values": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "normalized", "evidence_ids"],
              "properties": {
                "value": {"type": "string"},
                "normalized": {"type": ["string", "null"]},
                "evidence_ids": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "reason": {"type": "string"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_ocr_pages", "completed_ocr_pages", "terminal_ocr_pages", "pending_ocr_pages", "review_required_facts", "ocr_results_complete"],
      "properties": {
        "expected_ocr_pages": {"type": "integer", "minimum": 0},
        "completed_ocr_pages": {"type": "integer", "minimum": 0},
        "terminal_ocr_pages": {"type": "integer", "minimum": 0},
        "pending_ocr_pages": {"type": "integer", "minimum": 0},
        "review_required_facts": {"type": "integer", "minimum": 0},
        "ocr_results_complete": {"type": "boolean"}
      }
    },
    "entities": {"type": ["object", "null"]},
    "findings": {"type": ["object", "null"]},
    "source_artifacts": {"type": "object"}
  }
}
