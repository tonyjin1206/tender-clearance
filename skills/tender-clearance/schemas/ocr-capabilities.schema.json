  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/OCRCapabilities"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "rejection_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "array"
    }
  },
  "required": [
    "capabilities",
    "checked_at",
    "accepted"
  ],
  "title": "OCRCapabilitiesFile",
  "type": "object"
}
