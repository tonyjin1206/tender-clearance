#!/usr/bin/env python3
"""一次性文档资料解析入口。

先生成文本/字段候选与 OCR 任务，再生成文件属性；不执行 OCR、不联网。
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

import typer

app = typer.Typer(help="一次性解析文档内容、属性并生成宿主 OCR 任务")


@app.command()
def run(project_dir: Path = typer.Argument(..., exists=True, file_okay=False)) -> None:
    scripts = Path(__file__).resolve().parent
    for name in ("extract_content.py", "extract_metadata.py"):
        proc = subprocess.run(
            [sys.executable, str(scripts / name), str(project_dir)],
            capture_output=True, text=True,
        )
        output = (proc.stdout + proc.stderr).strip()
        if proc.returncode:
            if output:
                typer.echo(output, err=True)
            raise typer.Exit(code=proc.returncode)
        if output:
            typer.echo(output.splitlines()[-1])


if __name__ == "__main__":
    app()

