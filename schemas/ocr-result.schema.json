{
  "$defs": {
    "OCRBBox": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "OCRBBox",
      "type": "object"
    },
    "OCRBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/OCRBBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text",
        "confidence"
      ],
      "title": "OCRBlock",
      "type": "object"
    },
    "OCRProviderInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "processing_location": {
          "enum": [
            "local",
            "cloud"
          ],
          "title": "Processing Location",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "engine",
        "processing_location"
      ],
      "title": "OCRProviderInfo",
      "type": "object"
    },
    "OCRResult": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "ocr-result.v1",
          "title": "Contract Version",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "blocked",
            "not_supported",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/OCRProviderInfo"
        },
        "average_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Confidence"
        },
        "location_precision": {
          "default": "page_only",
          "enum": [
            "block",
            "page_only"
          ],
          "title": "Location Precision",
          "type": "string"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/OCRBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "job_id",
        "document_id",
        "source_sha256",
        "page",
        "status",
        "provider",
        "completed_at"
      ],
      "title": "OCRResult",
      "type": "object"
    },
    "RunInfo": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "description": "本次运行的唯一标识（uuid），允许跨运行不同",
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "description": "运行开始时间（允许跨运行不同）",
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "redaction_mode": {
          "description": "输出模式：none 表示按项目授权展示原值，standard 表示脱敏",
          "title": "Redaction Mode",
          "type": "string"
        },
        "id_digest_salt_fingerprint": {
          "description": "证件摘要盐的指纹（sha256 前 8 位），不保存盐本身",
          "title": "Id Digest Salt Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "tool_version",
        "rules_version",
        "python_version",
        "project_id",
        "redaction_mode",
        "id_digest_salt_fingerprint"
      ],
      "title": "RunInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run": {
      "$ref": "#/$defs/RunInfo"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/OCRResult"
      },
      "title": "Results",
      "type": "array"
    },
    "import_errors": {
      "items": {
        "type": "string"
      },
      "title": "Import Errors",
      "type": "array"
    }
  },
  "required": [
    "run",
    "results"
  ],
  "title": "OCRResultFile",
  "type": "object"
}
