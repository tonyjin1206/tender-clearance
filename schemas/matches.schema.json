{
  "$defs": {
    "CrossMatch": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "uscc",
            "legal_rep_id_digest",
            "bid_agent_id_digest",
            "legal_rep_name",
            "bid_agent_name",
            "shareholder_name",
            "phone",
            "email",
            "contact_name",
            "address",
            "company_name"
          ],
          "title": "Field",
          "type": "string"
        },
        "supplier_a": {
          "title": "Supplier A",
          "type": "string"
        },
        "supplier_b": {
          "title": "Supplier B",
          "type": "string"
        },
        "match_type": {
          "enum": [
            "exact",
            "fuzzy",
            "candidate"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "value_a": {
          "description": "脱敏后的比对值",
          "title": "Value A",
          "type": "string"
        },
        "value_b": {
          "title": "Value B",
          "type": "string"
        },
        "similarity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "match_id",
        "field",
        "supplier_a",
        "supplier_b",
        "match_type",
        "value_a",
        "value_b"
      ],
      "title": "CrossMatch",
      "type": "object"
    },
    "RunInfo": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "description": "本次运行的唯一标识（uuid），允许跨运行不同",
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "description": "运行开始时间（允许跨运行不同）",
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "redaction_mode": {
          "description": "脱敏模式；当前固定 standard",
          "title": "Redaction Mode",
          "type": "string"
        },
        "id_digest_salt_fingerprint": {
          "description": "证件摘要盐的指纹（sha256 前 8 位），不保存盐本身",
          "title": "Id Digest Salt Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "tool_version",
        "rules_version",
        "python_version",
        "project_id",
        "redaction_mode",
        "id_digest_salt_fingerprint"
      ],
      "title": "RunInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run": {
      "$ref": "#/$defs/RunInfo"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/CrossMatch"
      },
      "title": "Matches",
      "type": "array"
    }
  },
  "required": [
    "run",
    "matches"
  ],
  "title": "MatchesFile",
  "type": "object"
}
