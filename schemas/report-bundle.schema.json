{
  "$defs": {
    "ContactItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "phone",
            "email",
            "address"
          ],
          "title": "Kind",
          "type": "string"
        },
        "normalized_value": {
          "title": "Normalized Value",
          "type": "string"
        },
        "raw_masked": {
          "title": "Raw Masked",
          "type": "string"
        },
        "supplier_id": {
          "title": "Supplier Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "normalized_value",
        "raw_masked",
        "supplier_id",
        "evidence_ids"
      ],
      "title": "ContactItem",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "supplier_id": {
          "title": "Supplier Id",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "government_procurement",
            "srm"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "match",
            "no_match_verified",
            "no_result",
            "not_queried",
            "blocked",
            "failed",
            "needs_manual_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        }
      },
      "required": [
        "supplier_id",
        "source_id",
        "status"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "CrossMatch": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "uscc",
            "legal_rep_id_digest",
            "bid_agent_id_digest",
            "legal_rep_name",
            "bid_agent_name",
            "shareholder_name",
            "phone",
            "email",
            "contact_name",
            "address",
            "company_name"
          ],
          "title": "Field",
          "type": "string"
        },
        "supplier_a": {
          "title": "Supplier A",
          "type": "string"
        },
        "supplier_b": {
          "title": "Supplier B",
          "type": "string"
        },
        "match_type": {
          "enum": [
            "exact",
            "fuzzy",
            "candidate"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "value_a": {
          "description": "脱敏后的比对值",
          "title": "Value A",
          "type": "string"
        },
        "value_b": {
          "title": "Value B",
          "type": "string"
        },
        "similarity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "match_id",
        "field",
        "supplier_a",
        "supplier_b",
        "match_type",
        "value_a",
        "value_b"
      ],
      "title": "CrossMatch",
      "type": "object"
    },
    "DocumentMetadata": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/MetadataField"
          },
          "title": "Fields",
          "type": "array"
        },
        "page_image_fingerprints": {
          "description": "扫描页图像感知哈希（ahash），仅作线索",
          "items": {
            "type": "string"
          },
          "title": "Page Image Fingerprints",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "relative_path",
        "fields"
      ],
      "title": "DocumentMetadata",
      "type": "object"
    },
    "DocumentRecord": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "relative_path": {
          "description": "相对项目根目录的 POSIX 路径",
          "title": "Relative Path",
          "type": "string"
        },
        "supplier_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "位于 bids/ 下时的供应商目录名",
          "title": "Supplier Dir"
        },
        "category": {
          "enum": [
            "bid",
            "procurement",
            "external_evidence",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "bid_subtype": {
          "default": "unknown",
          "enum": [
            "business",
            "technical",
            "bid_schedule",
            "cover",
            "unknown"
          ],
          "title": "Bid Subtype",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "extraction_status": {
          "default": "ok",
          "enum": [
            "ok",
            "partial",
            "failed",
            "skipped",
            "password_protected",
            "corrupt",
            "unsupported",
            "empty"
          ],
          "title": "Extraction Status",
          "type": "string"
        },
        "status_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Detail"
        },
        "modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "文件系统修改时间；不能单独证明文档创作时间",
          "title": "Modified At"
        }
      },
      "required": [
        "document_id",
        "relative_path",
        "category",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "title": "DocumentRecord",
      "type": "object"
    },
    "EntitiesFile": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "suppliers": {
          "items": {
            "$ref": "#/$defs/Supplier"
          },
          "title": "Suppliers",
          "type": "array"
        },
        "parties": {
          "items": {
            "$ref": "#/$defs/Party"
          },
          "title": "Parties",
          "type": "array"
        },
        "contacts": {
          "items": {
            "$ref": "#/$defs/ContactItem"
          },
          "title": "Contacts",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "run",
        "suppliers",
        "parties",
        "contacts"
      ],
      "title": "EntitiesFile",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "bid_document",
            "procurement_document",
            "external_evidence",
            "metadata",
            "derived"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "location": {
          "additionalProperties": true,
          "description": "定位，如 {\"kind\":\"pdf_page\",\"page\":3}、{\"kind\":\"xlsx_cell\",\"sheet\":\"开标一览表\",\"cell\":\"B2\"}、{\"kind\":\"url\",\"url\":\"...\"}",
          "title": "Location",
          "type": "object"
        },
        "field": {
          "description": "字段名，如 uscc / legal_rep_name / phone / producer",
          "title": "Field",
          "type": "string"
        },
        "raw_value": {
          "description": "原文摘录；证件号/手机号已脱敏",
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "来源文件或快照哈希",
          "title": "Sha256"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "method": {
          "description": "提取方法，如 pdf_text_layer / xlsx_cell / image_exif / manual_import",
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "strength": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "title": "Strength",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "location",
        "field",
        "raw_value",
        "collected_at",
        "method",
        "strength"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "run",
        "evidence"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "ExternalEvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/ExternalQuery"
          },
          "title": "Queries",
          "type": "array"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ExternalRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "ownership": {
          "items": {
            "$ref": "#/$defs/OwnershipRelation"
          },
          "title": "Ownership",
          "type": "array"
        }
      },
      "required": [
        "run",
        "queries",
        "records"
      ],
      "title": "ExternalEvidenceFile",
      "type": "object"
    },
    "ExternalQuery": {
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "government_procurement",
            "srm"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "subject_supplier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Supplier Id"
        },
        "subject_key": {
          "additionalProperties": true,
          "description": "主体键，如 {\"uscc\": \"...\"} 或 {\"name\": \"...\"}",
          "title": "Subject Key",
          "type": "object"
        },
        "query_mode": {
          "enum": [
            "official_api",
            "browser_session",
            "public_web",
            "manual_import",
            "none"
          ],
          "title": "Query Mode",
          "type": "string"
        },
        "queried_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queried At"
        },
        "status": {
          "enum": [
            "match",
            "no_match_verified",
            "no_result",
            "not_queried",
            "blocked",
            "failed",
            "needs_manual_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "record_count": {
          "default": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        }
      },
      "required": [
        "query_id",
        "source_id",
        "subject_key",
        "query_mode",
        "status"
      ],
      "title": "ExternalQuery",
      "type": "object"
    },
    "ExternalRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "government_procurement",
            "srm"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "supplier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier Id"
        },
        "subject_confirmation": {
          "default": "unconfirmed",
          "enum": [
            "confirmed",
            "candidate",
            "unconfirmed"
          ],
          "title": "Subject Confirmation",
          "type": "string"
        },
        "subject_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Name"
        },
        "subject_uscc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Uscc"
        },
        "record_kind": {
          "enum": [
            "dishonesty",
            "penalty",
            "judicial_case",
            "ownership",
            "registration",
            "judicial_summary",
            "operating_risk",
            "operating_summary",
            "other"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "fields": {
          "additionalProperties": true,
          "description": "原始记录字段，如案号/处罚决定文号/当事人/日期/禁入期限等",
          "title": "Fields",
          "type": "object"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "source_id",
        "record_kind",
        "fields"
      ],
      "title": "ExternalRecord",
      "type": "object"
    },
    "ExtractionAnomaly": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        },
        "anomaly": {
          "title": "Anomaly",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "anomaly"
      ],
      "title": "ExtractionAnomaly",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "domain": {
          "enum": [
            "identity",
            "metadata",
            "ownership",
            "judicial",
            "dishonesty",
            "coverage"
          ],
          "title": "Domain",
          "type": "string"
        },
        "level": {
          "enum": [
            "I",
            "II",
            "III"
          ],
          "title": "Level",
          "type": "string"
        },
        "evidence_strength": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "title": "Evidence Strength",
          "type": "string"
        },
        "supplier_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supplier Ids",
          "type": "array"
        },
        "subject_confirmation": {
          "default": "confirmed",
          "enum": [
            "confirmed",
            "candidate",
            "unconfirmed"
          ],
          "title": "Subject Confirmation",
          "type": "string"
        },
        "fact": {
          "description": "发现事实（脱敏、中性表述，不作违法/串标认定）",
          "title": "Fact",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "related_ids": {
          "description": "关联的 match_id / query_id / record_id",
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "human_review_required",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "recommendation": {
          "default": "",
          "description": "建议复核动作",
          "title": "Recommendation",
          "type": "string"
        },
        "procurement_clause_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "与采购文件资格条款的匹配结果；无条款时为“资格影响待采购人确认”",
          "title": "Procurement Clause Note"
        },
        "missing_materials": {
          "items": {
            "type": "string"
          },
          "title": "Missing Materials",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "rules_version",
        "domain",
        "level",
        "evidence_strength",
        "fact"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingsFile": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          },
          "title": "Coverage",
          "type": "array"
        },
        "human_review_queue": {
          "description": "必须人工复核的 finding_id",
          "items": {
            "type": "string"
          },
          "title": "Human Review Queue",
          "type": "array"
        }
      },
      "required": [
        "run",
        "findings",
        "coverage"
      ],
      "title": "FindingsFile",
      "type": "object"
    },
    "InventoryFile": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentRecord"
          },
          "title": "Documents",
          "type": "array"
        },
        "anomalies": {
          "items": {
            "$ref": "#/$defs/ExtractionAnomaly"
          },
          "title": "Anomalies",
          "type": "array"
        },
        "supplier_dirs": {
          "items": {
            "type": "string"
